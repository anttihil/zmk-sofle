#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        // Home row mod for layer activation
        hml: homerow_mod_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 27 40>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_SHIFT>,
                <&macro_press &mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release &mkp MB3>,
                <&macro_release &kp LEFT_SHIFT>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC    &kp N1    &kp N2       &kp N3       &kp N4      &kp N5      &kp UP_ARROW      &kp N6     &kp N7     &kp N8     &kp N9    &kp N0       &kp BSPC
&kp TAB    &kp Q     &kp W        &kp E        &kp R       &kp T       &kp DOWN_ARROW    &kp Y      &kp U      &kp I      &kp O     &kp P        &kp DEL
&kp LALT   &kp A     &hml 1 S     &hml 2 D     &hml 3 F    &kp G       &kp LEFT_ARROW    &kp H      &kp J      &kp K      &kp L     &hml 1 SEMI  &kp APOS
&kp LSHFT  &kp Z     &kp X        &kp C        &kp V       &kp B       &kp RIGHT_ARROW   &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH     &kp RSHFT
&kp C_MUTE &mo 4     &kp LCTRL    &kp LGUI     &kp DEL     &kp BSPC    &kp ENTER         &kp ENTER  &kp SPACE  &kp RCTRL  &kp RALT  &kp CAPS
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            display-name = "base";
        };

        layer_1 {
            bindings = <
&kp F1      &kp F2           &kp F3          &kp F4           &kp F5           &kp F6           &mmv MOVE_UP      &kp F7           &kp F8           &kp F9      &kp F10   &kp F11   &kp F12
&none       &none            &mkp LCLK       &mkp MCLK        &mkp RCLK        &mkp MB4         &mmv MOVE_DOWN    &kp PG_UP        &kp END          &kp UP      &kp HOME  &none     &none
&trans      &none            &none           &none            &none            &mkp MB5         &mmv MOVE_LEFT    &kp PG_DN        &kp LEFT         &kp DOWN    &kp RIGHT &none     &none
&trans      &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &mmv MOVE_RIGHT   &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp INSERT  &none     &none     &trans
&kp C_MUTE  &trans           &trans          &trans           &trans           &trans           &mkp LCLK         &trans           &trans           &trans      &trans    &trans
            >;

            display-name = "navigation";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_2 {
            bindings = <
&none   &none   &none   &none   &none   &none   &none  &none      &none      &none      &none      &none     &none
&none   &none   &none   &none   &none   &none   &none  &kp TILDE  &kp UNDER  &kp PLUS   &kp STAR   &kp PIPE  &none
&trans  &none   &none   &none   &none   &none   &none  &kp GRAVE  &kp EQUAL  &kp MINUS  &kp SLASH  &kp BSLH  &none
&trans  &none   &none   &none   &none   &none   &none  &none      &none      &none      &none      &none     &trans
&none   &trans  &trans  &trans  &trans  &trans  &none  &trans     &trans     &trans     &trans     &trans
            >;

            display-name = "symbols";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            bindings = <
&none   &none   &none   &none   &none   &none   &none  &none     &none     &none     &none     &none  &none
&none   &none   &none   &none   &none   &none   &none  &kp LT    &kp GT    &kp LBKT  &kp RBKT  &none  &none
&trans  &none   &none   &none   &none   &none   &none  &kp LPAR  &kp RPAR  &kp LBRC  &kp RBRC  &none  &none
&trans  &none   &none   &none   &none   &none   &none  &none     &none     &none     &none     &none  &trans
&none   &trans  &trans  &trans  &trans  &trans  &none  &trans    &trans    &trans    &trans    &trans
            >;

            display-name = "brackets";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_4 {
            bindings = <
&none   &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none  &none  &none         &none  &none        &none  &none
&none   &none           &none         &none         &sys_reset    &none         &none  &none  &out OUT_USB  &none  &soft_off    &none  &none
&trans  &bt BT_CLR_ALL  &none         &none         &none         &none         &none  &none  &none         &none  &bootloader  &none  &none
&trans  &none           &none         &bt BT_CLR    &none         &out OUT_BLE  &none  &none  &none         &none  &none        &none  &trans
&none   &trans          &trans        &trans        &trans        &trans        &none  &trans &trans        &trans &trans       &trans
            >;

            display-name = "bluetooth";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};